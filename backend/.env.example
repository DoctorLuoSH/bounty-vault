# BountyVault backend configuration. Copy to .env and fill in real values.
# NEVER commit a real .env (git-ignored); only this template is committed.

# Port the Express API listens on.
PORT=3001

# SQLite database file (created on first run; the file itself is git-ignored).
DATABASE_PATH=./data/bountyvault.db

# JSON-RPC endpoint of the chain node (local Hardhat node or Sepolia RPC).
RPC_URL=http://127.0.0.1:8545

# Deployed BountyVault contract address (0x-prefixed, 42 chars).
# Leave empty to run the API without the event indexer.
CONTRACT_ADDRESS=

# Block the contract was deployed at; first-boot indexing starts from here.
DEPLOYMENT_BLOCK=0

# Event indexer tuning (docs/ARCHITECTURE.md section 3.3).
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL_MS=15000
INDEXER_CONFIRMATIONS=12
INDEXER_BLOCK_CHUNK=2000
