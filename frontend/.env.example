# Address of the deployed BountyVault contract (printed by contracts/scripts/deploy.js)
VITE_CONTRACT_ADDRESS=

# Chain the app enforces. 11155111 = Sepolia (default), 31337 = local Hardhat node.
VITE_CHAIN_ID=11155111

# Backend API base URL (off-chain metadata + event index). When unreachable the
# app falls back to reading the contract directly; see the data-source toggle.
VITE_BACKEND_URL=http://localhost:3001
